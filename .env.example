# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only, read by /api functions).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional self-referential URL (kept for compatibility with prior tooling).
APP_URL="MY_APP_URL"

# Supabase project credentials — get these from Settings > API in your Supabase project.
# VITE_-prefixed vars are exposed to the browser bundle by Vite; the plain ones are read
# server-side by the Vercel functions under /api (Node runtime, not bundled by Vite).
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# SUPABASE_SERVICE_ROLE_KEY: used by the Mercado Pago webhook and admin backend routes
# (Pilar 2). NEVER put it in a VITE_-prefixed variable — it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Mercado Pago — credentials from your application at developers.mercadopago.com.br.
MP_ACCESS_TOKEN="YOUR_MP_ACCESS_TOKEN"

# MP_WEBHOOK_SECRET: signature secret from your app's Webhooks screen in the MP dashboard.
MP_WEBHOOK_SECRET="cole-aqui"

# CRON_SECRET: generated locally (e.g. `openssl rand -hex 32`), protects
# /api/cron/billing from external calls.
CRON_SECRET="cole-aqui"

# MP_PUBLIC_KEY: chave pública do app no Mercado Pago (vai ao navegador via /api/billing/config).
MP_PUBLIC_KEY=

# Resend (e-mails transacionais). MAIL_FROM precisa ser de um domínio verificado (SPF/DKIM).
RESEND_API_KEY=
MAIL_FROM=
